generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ResumeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ResumeEventType {
  VIEW
  DOWNLOAD
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuditCategory {
  AUTH
  USER
  RESUME
  SETTINGS
  SECURITY
  SUPPORT
  SYSTEM
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum SupportTicketType {
  FEEDBACK
  CONTACT
  ACCOUNT_RECOVERY
  TECHNICAL_ERROR
  ABUSE_REPORT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model User {
  id                 String                   @id
  email              String                   @unique
  name               String?
  avatarUrl          String?
  jobTitle           String?
  location           String?
  website            String?
  bio                String?
  role               UserRole                 @default(USER)
  status             UserStatus               @default(ACTIVE)
  mustChangePassword Boolean                  @default(false)
  onboardingDone     Boolean                  @default(false)
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  lastActiveAt       DateTime?
  sessionsRevokedAt  DateTime?
  suspendedAt        DateTime?
  deletedAt          DateTime?
  purgeScheduledAt   DateTime?
  authProvider       String                   @default("email")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  resumes            Resume[]
  auditLogs          AdminAuditLog[]          @relation("AuditActor")
  moderationActions  ResumeModerationAction[] @relation("ModerationActor")
  settingsChanges    SystemSetting[]          @relation("SettingUpdater")
  assignedTickets    SupportTicket[]          @relation("TicketAssignee")
  supportTickets     SupportTicket[]          @relation("TicketRequester")
  supportMessages    SupportMessage[]
  announcements      Announcement[]           @relation("AnnouncementAuthor")
  securityEvents     SecurityEvent[]

  @@index([status, createdAt])
  @@index([role, status])
  @@index([lastActiveAt])
  @@index([status, purgeScheduledAt])
}

model Resume {
  id                 String                   @id @default(cuid())
  userId             String
  title              String
  slug               String                   @unique
  status             ResumeStatus             @default(DRAFT)
  isPublic           Boolean                  @default(false)
  template           String                   @default("clarity")
  fontFamily         String                   @default("Inter")
  accentColor        String                   @default("#6D5DFB")
  spacing            String                   @default("comfortable")
  paperSize          String                   @default("A4")
  personalInfo       PersonalInfo?
  summary            String                   @default("")
  completion         Int                      @default(0)
  revision           Int                      @default(0)
  archivedAt         DateTime?
  moderationHiddenAt DateTime?
  moderationReason   String?
  lastSavedAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections           ResumeSection[]
  education          Education[]
  experience         WorkExperience[]
  skills             Skill[]
  projects           Project[]
  certifications     Certification[]
  languages          Language[]
  awards             Award[]
  interests          Interest[]
  references         Reference[]
  events             ResumeEvent[]
  reports            ResumeReport[]
  moderation         ResumeModerationAction[]

  @@index([userId, updatedAt])
  @@index([userId, status])
  @@index([userId, archivedAt, updatedAt])
  @@index([moderationHiddenAt, updatedAt])
}

model ResumeReport {
  id           String       @id @default(cuid())
  resumeId     String
  reason       String
  details      String?
  reporterHash String?
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  resume       Resume       @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([resumeId, status])
}

model ResumeModerationAction {
  id        String   @id @default(cuid())
  resumeId  String
  actorId   String?
  action    String
  reason    String?
  metadata  Json?
  createdAt DateTime @default(now())
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  actor     User?    @relation("ModerationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([resumeId, createdAt])
  @@index([actorId, createdAt])
}

model PersonalInfo {
  id        String  @id @default(cuid())
  resumeId  String  @unique
  firstName String  @default("")
  lastName  String  @default("")
  jobTitle  String  @default("")
  email     String  @default("")
  phone     String  @default("")
  city      String  @default("")
  country   String  @default("")
  website   String  @default("")
  linkedin  String  @default("")
  github    String  @default("")
  photoUrl  String?
  resume    Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model ResumeSection {
  id        String  @id @default(cuid())
  resumeId  String
  key       String
  label     String
  position  Int
  isVisible Boolean @default(true)
  resume    Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, key])
  @@index([resumeId, position])
}

model Education {
  id          String    @id @default(cuid())
  resumeId    String
  school      String
  degree      String
  field       String?
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  current     Boolean   @default(false)
  description String?
  position    Int
  resume      Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, position])
}

model WorkExperience {
  id          String    @id @default(cuid())
  resumeId    String
  company     String
  role        String
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  current     Boolean   @default(false)
  description String?
  position    Int
  resume      Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, position])
}

model Skill {
  id       String  @id @default(cuid())
  resumeId String
  name     String
  level    Int?
  category String?
  position Int
  resume   Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, position])
}

model Project {
  id           String    @id @default(cuid())
  resumeId     String
  name         String
  role         String?
  url          String?
  startDate    DateTime?
  endDate      DateTime?
  description  String?
  technologies String[]
  position     Int
  resume       Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, position])
}

model Certification {
  id             String    @id @default(cuid())
  resumeId       String
  name           String
  issuer         String
  issueDate      DateTime?
  expirationDate DateTime?
  credentialId   String?
  credentialUrl  String?
  position       Int
  resume         Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, position])
}

model Language {
  id          String @id @default(cuid())
  resumeId    String
  name        String
  proficiency String
  position    Int
  resume      Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, position])
}

model Award {
  id          String    @id @default(cuid())
  resumeId    String
  title       String
  issuer      String?
  awardedAt   DateTime?
  description String?
  position    Int
  resume      Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, position])
}

model Interest {
  id       String @id @default(cuid())
  resumeId String
  name     String
  position Int
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, position])
}

model Reference {
  id           String  @id @default(cuid())
  resumeId     String
  name         String
  relationship String?
  company      String?
  email        String?
  phone        String?
  position     Int
  resume       Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, position])
}

model ResumeEvent {
  id          String          @id @default(cuid())
  resumeId    String
  type        ResumeEventType
  visitorHash String?
  dayKey      String
  createdAt   DateTime        @default(now())
  resume      Resume          @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, type, visitorHash, dayKey])
  @@index([resumeId, type, createdAt])
  @@index([resumeId, dayKey, type])
}

model AdminAuditLog {
  id         String        @id @default(cuid())
  actorId    String?
  category   AuditCategory
  severity   AuditSeverity @default(INFO)
  action     String
  targetType String?
  targetId   String?
  summary    String
  metadata   Json?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime      @default(now())
  actor      User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model SecurityEvent {
  id          String        @id @default(cuid())
  userId      String?
  type        String
  severity    AuditSeverity @default(INFO)
  description String
  ipHash      String?
  metadata    Json?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([severity, resolvedAt, createdAt])
  @@index([userId, createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  updatedBy   User?    @relation("SettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedAt])
}

model TemplateConfiguration {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(true)
  position    Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([enabled, position])
}

model SupportTicket {
  id           String              @id @default(cuid())
  requesterId  String?
  assignedToId String?
  email        String
  subject      String
  type         SupportTicketType
  status       SupportTicketStatus @default(OPEN)
  priority     SupportPriority     @default(NORMAL)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  resolvedAt   DateTime?
  requester    User?               @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  assignedTo   User?               @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     SupportMessage[]

  @@index([status, priority, updatedAt])
  @@index([type, createdAt])
  @@index([requesterId, createdAt])
  @@index([assignedToId, status])
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  authorId   String?
  body       String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String
  published Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, position])
  @@index([category, position])
}

model Announcement {
  id        String    @id @default(cuid())
  authorId  String?
  title     String
  message   String
  kind      String    @default("info")
  active    Boolean   @default(true)
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  author    User?     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([active, startsAt, endsAt])
}
