# Prisma Postgres pooled connection URL
DATABASE_URL="prisma+postgres://..."

# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Used only for trusted server-side account, storage, and moderation operations.
# Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Public Vercel URL, without a trailing slash
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Initial administrator (used only by `npx prisma db seed`)
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="replace-with-a-strong-unique-password"
DEFAULT_ADMIN_NAME="Resumly Administrator"

# One-time recovery switch. Set true only for a seed run that must synchronize
# DEFAULT_ADMIN_PASSWORD into an existing seeded Supabase administrator, then
# remove it or set it back to false.
SYNC_DEFAULT_ADMIN_PASSWORD="false"

# At least 32 random characters. Used to pseudonymize analytics visitors.
ANALYTICS_HASH_SALT="replace-with-a-long-random-secret"

# Atomic distributed rate limiting (required in production)
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-the-standard-rest-token"

# Vercel Cron bearer secret (at least 32 random characters)
CRON_SECRET="replace-with-a-long-random-secret"

# Transactional product email (Supabase Auth email uses its own SMTP settings)
RESEND_API_KEY="re_replace-with-a-production-api-key"
EMAIL_FROM="Blue Horizon CV <notifications@example.com>"

# Optional provider-neutral error ingestion and critical security alert webhook.
# Compatible with an internal collector, Better Stack, Axiom, or a Sentry relay.
MONITORING_INGEST_URL=""
MONITORING_INGEST_TOKEN=""
SECURITY_ALERT_WEBHOOK_URL=""

# Use in CI to enforce all production-required variables before deployment.
STRICT_ENV_VALIDATION="false"
